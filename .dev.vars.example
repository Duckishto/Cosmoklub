# Copy this file to `.dev.vars` and fill in your own values, then run:
#   npx wrangler pages dev .
#
# These are the same two variables set in the Cloudflare Pages dashboard
# (Settings -> Environment variables). `functions/api/supabase-config.js`
# reads them and hands them to the browser at request time.
#
# Both values are safe to expose to the browser — Row Level Security in
# supabase/schema.sql is what protects the data, not secrecy of this key.
# Never put a Supabase "secret" or "service_role" key here.
#
# Find them in: Supabase dashboard -> Project Settings -> API Keys

SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
